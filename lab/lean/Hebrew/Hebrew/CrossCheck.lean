import Hebrew.Basic
import Hebrew.Oracle

/-!
# Cross-check against the reference oracle (test, not a theorem)

`oracleRH` is generated by `lab/experiments/hebrew-calendar/gen_oracle.py` from
`lab/experiments/novelty/sanity/hebrew_period.py` (Dershowitz–Reingold style formulas,
with the 3rd/4th dechiyot expressed via the 356/382-day tests). `#guard` evaluates with
the Lean interpreter (compiled code), so this is computational evidence (L1), not a
kernel proof. The kernel-checked equivalence for *all* years is `Hebrew.rambam_eq_dr`
(Theorems.lean).
-/

namespace Hebrew

/-- Years 1..10001: Rambam-style `roshHashanah` equals the oracle's day number. -/
def crossCheckRH : Bool :=
  (List.range oracleRH.size).all fun i => roshHashanah (i + 1) == oracleRH[i]!

#guard oracleRH.size == 10001
#guard crossCheckRH
-- hence keviyah (weekday, length) agrees for years 1..10000.

end Hebrew

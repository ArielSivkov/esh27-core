s_supply": 8455774}, {"scenario": "הנפקה אגרסיבית", "day": 410, "agents_supply": 8454445}, {"scenario": "הנפקה אגרסיבית", "day": 420, "agents_supply": 8418826}, {"scenario": "הנפקה אגרסיבית", "day": 430, "agents_supply": 8433625}, {"scenario": "הנפקה אגרסיבית", "day": 440, "agents_supply": 8464643}, {"scenario": "הנפקה אגרסיבית", "day": 450, "agents_supply": 8369308}, {"scenario": "הנפקה אגרסיבית", "day": 460, "agents_supply": 8374213}, {"scenario": "הנפקה אגרסיבית", "day": 470, "agents_supply": 8356075}, {"scenario": "הנפקה אגרסיבית", "day": 480, "agents_supply": 8391149}, {"scenario": "הנפקה אגרסיבית", "day": 490, "agents_supply": 8425482}, {"scenario": "הנפקה אגרסיבית", "day": 500, "agents_supply": 8406607}, {"scenario": "הנפקה אגרסיבית", "day": 510, "agents_supply": 8295532}, {"scenario": "הנפקה אגרסיבית", "day": 520, "agents_supply": 8322319}, {"scenario": "הנפקה אגרסיבית", "day": 530, "agents_supply": 8325913}, {"scenario": "הנפקה אגרסיבית", "day": 540, "agents_supply": 8322508}, {"scenario": "הנפקה אגרסיבית", "day": 550, "agents_supply": 8361203}, {"scenario": "הנפקה אגרסיבית", "day": 560, "agents_supply": 8303698}, {"scenario": "הנפקה אגרסיבית", "day": 570, "agents_supply": 8248687}, {"scenario": "הנפקה אגרסיבית", "day": 580, "agents_supply": 6228676}, {"scenario": "הנפקה אגרסיבית", "day": 590, "agents_supply": 5310514}, {"scenario": "הנפקה אגרסיבית", "day": 600, "agents_supply": 5096082}, {"scenario": "הנפקה אגרסיבית", "day": 610, "agents_supply": 4942342}, {"scenario": "הנפקה אגרסיבית", "day": 620, "agents_supply": 4800843}, {"scenario": "הנפקה אגרסיבית", "day": 630, "agents_supply": 4655992}, {"scenario": "הנפקה אגרסיבית", "day": 640, "agents_supply": 4553391}, {"scenario": "הנפקה אגרסיבית", "day": 650, "agents_supply": 4424688}, {"scenario": "הנפקה אגרסיבית", "day": 660, "agents_supply": 4279592}, {"scenario": "הנפקה אגרסיבית", "day": 670, "agents_supply": 4159388}, {"scenario": "הנפקה אגרסיבית", "day": 680, "agents_supply": 4052779}, {"scenario": "הנפקה אגרסיבית", "day": 690, "agents_supply": 3927903}, {"scenario": "הנפקה אגרסיבית", "day": 700, "agents_supply": 3851545}, {"scenario": "הנפקה אגרסיבית", "day": 710, "agents_supply": 3723714}, {"scenario": "הנפקה אגרסיבית", "day": 720, "agents_supply": 3656862}], "meta": [{"label": "tokenomics_sim.py", "value": "\"\"\"הדמיית טוקנומיקס v0 — \"קרדיט עיר\" (CRD) בתוך אשדוד הווירטואלית.\n\nהדמיה בלבד. אין כאן שום חיבור לרשת, ארנק או כסף.\nהרצה:  python3 tokenomics_sim.py   (פלט: results.md לצד הקובץ)\n\nמודל:\n- סוכנים מרוויחים CRD על עבודה (בנייה, יצירה, שירות) מתוך \"ברז\" הנפקה יומי שדועך.\n- סוכנים מוציאים CRD על מחשוב / בנייה / גישה; אחוז מכל הוצאה נשרף (sink), השאר לאוצר העיר.\n- תקרת היצע קשיחה. בודקים: אינפלציה, ריכוזיות (Gini, top-10%), וניצול (חוות sybil).\n\"\"\"\nfrom __future__ import annotations\n\nimport random\nfrom dataclasses import dataclass, field\nfrom pathlib import Path\n\nMAX_SUPPLY = 1_000_000_000\nDAYS = 730\n\n\n@dataclass\nclass Params:\n    name: str\n    n_agents: int = 500\n    daily_emission: float = 400_000      # CRD ביום בהתחלה\n    emission_decay: float = 0.998        # דעיכה יומית (~ חצי בשנה)\n    burn_rate: float = 0.30              # חלק מכל הוצאה שנשרף\n    spend_fraction: float = 0.25         # כמה מהיתרה סוכן מוציא ביום (אם יש לו מה לעשות)\n    per_agent_daily_cap: float = 5_000   # תקרת הרוויח יומית לסוכן (אנטי-ניצול)\n    sybil_agents: int = 0                # סוכנים מזויפים של תוקף אחד\n    sybil_skill: float = 1.0             # כמה \"עבודה\" כל sybil מצליח לזייף\n    proof_of_work_filter: bool = True    # האם יש סינון איכות לעבודה (מקטין sybil)\n    treasury_recycle: float = 0.01      # חלק מאוצר העיר שחוזר כתגמולים כל יום\n    seed: int = 27\n\n\n@dataclass\nclass Agent:\n    skill: float\n    balance: float = 0.0\n    earned: float = 0.0\n    sybil: bool = False\n\n\n@dataclass\nclass Result:\n    p: Params\n    supply: list = field(default_factory=list)\n    burned: float = 0.0\n    treasury: float = 0.0\n\n\ndef gini(xs: list[float]) -> float:\n    xs = sorted(xs)\n    n = len(xs)\n    s = sum(xs)\n    if s == 0:\n        return 0.0\n    cum = sum((i + 1) * x for i, x in enumerate(xs))\n    return (2 * cum) / (n * s) - (n + 1) / n\n\n\ndef run(p: Params) -> Result:\n    rng = random.Random(p.seed)\n    agents = [Agent(skill=rng.lognormvariate(0, 0.6)) for _ in range(p.n_agents)]\n    for _ in range(p.sybil_agents):\n        skill = p.sybil_skill * (0.15 if p.proof_of_work_filter else 1.0)\n        agents.append(Agent(skill=skill, sybil=True))\n\n    r = Result(p)\n    minted = 0.0\n    emission = p.daily_emission\n    for _day in range(DAYS):\n        # 1) הנפקה: מחולקת לפי עבודה (skill * רעש), עם תקרה לסוכן\n        room = max(0.0, MAX_SUPPLY - minted)\n        new_mint = min(emission, room)\n        recycled = r.treasury * p.treasury_recycle\n        r.treasury -= recycled\n        today = new_mint + recycled\n        work = [a.skill * rng.uniform(0.5, 1.5) for a in agents]\n        total_work = sum(work) or 1.0\n        for a, w in zip(agents, work):\n            pay = min(today * w / total_work, p.per_agent_daily_cap)\n            a.balance += pay\n            a.earned += pay\n        minted += new_mint  # עודף מעל התקרה לסוכן פשוט לא מונפק/לא מחולק (פישוט)\n        emission *= p.emission_decay\n\n        # 2) הוצאה: sink. sybil-ים לא מוציאים (הם חוות) — זה בדיוק הסיכון\n        for a in agents:\n            if a.sybil:\n                continue\n            spend = a.balance * p.spend_fraction * rng.uniform(0.5, 1.0)\n            a.balance -= spend\n            r.burned += spend * p.burn_rate\n            r.treasury += spend * (1 - p.burn_rate)\n\n        circ = sum(a.balance for a in agents)\n        r.supply.append(circ)\n    r.minted = minted\n    r.agents = agents\n    return r\n\n\ndef summarize(r: Result) -> dict:\n    bal = [a.balance for a in r.agents]\n    bal_sorted = sorted(bal, reverse=True)\n    top10 = sum(bal_sorted[: max(1, len(bal) // 10)]) / (sum(bal) or 1)\n    earned = sum(a.earned for a in r.agents) or 1\n    syb = sum(a.earned for a in r.agents if a.sybil) / earned\n    s = r.supply\n    infl_y1 = (s[364] - s[0]) / (s[0] or 1)\n    infl_y2 = (s[729] - s[364]) / (s[364] or 1)\n    return {\n        \"minted_pct_of_cap\": r.minted / MAX_SUPPLY,\n        \"circulating_end\": s[-1],\n        \"burned\": r.burned,\n        \"treasury\": r.treasury,\n        \"growth_y1\": infl_y1,\n        \"growth_y2\": infl_y2,\n        \"gini\": gini(bal),\n        \"top10_share\": top10,\n        \"sybil_share\": syb,\n    }\n\n\nSCENARIOS = [\n    Params(\"בסיס\"),\n    Params(\"בלי שריפה\", burn_rate=0.0),\n    Params(\"בלי הוצאה (אין מה לקנות)\", spend_fraction=0.01),\n    Params(\"תקיפת sybil, עם סינון\", sybil_agents=500),\n    Params(\"תקיפת sybil, בלי סינון ובלי תקרה\", sybil_agents=500,\n           proof_of_work_filter=False, per_agent_daily_cap=1e12),\n    Params(\"הנפקה אגרסיבית\", daily_emission=2_000_000, emission_decay=0.9995),\n]\n\n\ndef main() -> None:\n    rows = []\n    for p in SCENARIOS:\n        rows.append((p.name, summarize(run(p))))\n    out = [\n        \"# תוצאות הדמיית טוקנומיקס v0 (CRD)\",\n        \"\",\n        \"> הדמיה בלבד, מודל פשוט. מספרים להשוואה בין תרחישים, לא תחזית.\",\n        \"\",\n        \"| תרחיש | % מהתקרה שהונפק | בידי סוכנים בסוף | באוצר העיר | נשרף | שינוי במחזור, שנה 2 | Gini | 10% העליונים | התוקף קיבל מהתגמולים |\",\n        \"|---|---|---|---|---|---|---|---|---|\",\n    ]\n    for name, m in rows:\n        out.append(\n            f\"| {name} | {m['minted_pct_of_cap']:.1%} | {m['circulating_end']:,.0f} | \"\n            f\"{m['treasury']:,.0f} | {m['burned']:,.0f} | {m['growth_y2']:+.0%} | {m['gini']:.2f} | \"\n            f\"{m['top10_share']:.0%} | {m['sybil_share']:.0%} |\"\n        )\n    path = Path(__file__).with_name(\"results.md\")\n    path.write_text(\"\\n\".join(out) + \"\\n\", encoding=\"utf-8\")\n    print(\"\\n\".join(out))\n\n\nif __name__ == \"__main__\":\n    main()\n", "type": "code", "lang": "python"}, {"label": "export_data.py", "value": "\"\"\"מייצא נתונים לדשבורד ההדגמה: תוצאות הדמיה + תוצאות בדיקות צוות אדום.\nהרצה מתוך lab/crypto:  python3 -I dashboard/export_data.py\n\"\"\"\nimport json, subprocess, sys, os\nfrom pathlib import Path\n\nHERE = Path(__file__).resolve().parent\nROOT = HERE.parent\nsys.path.insert(0, str(ROOT / \"stage2-design\" / \"sim\"))\nimport tokenomics_sim as sim  # noqa: E402\n\nown_code = Path(__file__).read_text(encoding=\"utf-8\")\nsim_code = (ROOT / \"stage2-design\" / \"sim\" / \"tokenomics_sim.py\").read_text(encoding=\"utf-8\")\n\n# 1) טבלת תרחישים + 2) היצע במחזור לאורך זמן\nrows, series = [], []\nfor i, p in enumerate(sim.SCENARIOS):\n    r = sim.run(p)\n    m = sim.summarize(r)\n    rows.append({\n        \"order\": i, \"scenario\": p.name,\n        \"minted_pct\": round(m[\"minted_pct_of_cap\"] * 100, 2),\n        \"agents_end\": round(m[\"circulating_end\"]),\n        \"treasury_end\": round(m[\"treasury\"]),\n        \"burned\": round(m[\"burned\"]),\n        \"growth_y2_pct\": round(m[\"growth_y2\"] * 100, 1),\n        \"gini\": round(m[\"gini\"], 3),\n        \"top10_pct\": round(m[\"top10_share\"] * 100, 1),\n        \"attacker_pct\": round(m[\"sybil_share\"] * 100, 1),\n    })\n    for d in range(0, sim.DAYS, 10):\n        series.append({\"scenario\": p.name, \"day\": d, \"agents_supply\": round(r.supply[d])})\n\nmeta = [\n    {\"label\": \"tokenomics_sim.py\", \"value\": sim_code, \"type\": \"code\", \"lang\": \"python\"},\n    {\"label\": \"export_data.py\", \"value\": own_code, \"type\": \"code\", \"lang\": \"python\"},\n    {\"label\": \"Input\", \"value\": \"פרמטרים קבועים בקוד, seed=27, ‏730 ימים\"},\n]\n(HERE / \"sim_results.json\").write_text(json.dumps({\"rows\": rows, \"meta\": meta}, ensure_ascii=False), encoding=\"utf-8\")\n(HERE / \"sim_supply.json\").write_text(json.dumps({\"rows\": series, \"meta\": meta}, ensure_ascii=False), encoding=\"utf-8\")\n\n# 3) בדיקות החוזים (hardhat, רשת מקומית)\nout = HERE / \"_mocha.json\"\nenv = dict(os.environ, MOCHA_JSON=str(out))\nsubprocess.run([\"npx\", \"hardhat\", \"test\"], cwd=ROOT / \"stage3-testnet\", env=env, check=False,\n               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\nrep = json.loads(out.read_text(encoding=\"utf-8\"))\nout.unlink()\ntests = []\nfor t in rep[\"tests\"]:\n    suite = t[\"fullTitle\"][: len(t[\"fullTitle\"]) - len(t[\"title\"])].strip()\n    tests.append({\n        \"suite\": suite, \"test\": t[\"title\"],\n        \"status\": \"עבר\" if not t.get(\"err\") or not t[\"err\"] else \"נכשל\",\n        \"red_team\": \"צוות אדום\" in t[\"title\"],\n    })\ntest_meta = [\n    {\"label\": \"export_data.py\", \"value\": own_code, \"type\": \"code\", \"lang\": \"python\"},\n    {\"label\": \"Input\", \"value\": \"npx hardhat test (stage3-testnet/test/redteam.test.js), רשת hardhat מקומית\"},\n]\n(HERE / \"tests.json\").write_text(json.dumps({\"rows\": tests, \"meta\": test_meta}, ensure_ascii=False), encoding=\"utf-8\")\nprint(len(rows), \"scenarios;\", len(series), \"points;\", len(tests), \"tests;\",\n      sum(t[\"status\"] == \"עבר\" for t in tests), \"passed\")\n", "type": "code", "lang": "python"}, {"label": "Input", "value": "פרמטרים קבועים בקוד, seed=27, ‏730 ימים"}]}
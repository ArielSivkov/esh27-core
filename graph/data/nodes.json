[
  {"id": "person:avraham", "type": "person", "label_he": "אברהם אבינו", "label_en": "Abraham", "aliases": ["אברהם"], "layer": "torah", "cluster_id": "P01", "era": "avot", "external": {"wikidata": "Q9181", "sefaria_topic": "abraham"}, "text_he": "ראש האבות והמאמינים בספר בראשית; עמוד החסד וראש שלשלת האומה."},
  {"id": "person:yitzchak", "type": "person", "label_he": "יצחק אבינו", "label_en": "Isaac", "aliases": ["יצחק"], "layer": "torah", "cluster_id": "P02", "era": "avot", "external": {"wikidata": "Q671872", "sefaria_topic": "isaac"}, "text_he": "האב השני משלושת האבות, בן אברהם ושרה; עמוד הגבורה והדין."},
  {"id": "person:yaakov", "type": "person", "label_he": "יעקב אבינו", "label_en": "Jacob", "aliases": ["ישראל", "יעקב"], "layer": "torah", "cluster_id": "P03", "era": "avot", "external": {"wikidata": "Q289957", "sefaria_topic": "jacob"}, "text_he": "האב השלישי משלושת האבות, בן יצחק ורבקה ואבי שנים-עשר שבטי ישראל."},
  {"id": "person:yosef", "type": "person", "label_he": "יוסף הצדיק", "label_en": "Joseph", "aliases": ["יוסף", "צפנת פענח"], "layer": "torah", "cluster_id": "P04", "era": "avot", "external": {"wikidata": null, "sefaria_topic": "joseph"}, "text_he": "בן יעקב ורחל, המשביר למצרים ומפענח החלומות בפרשת מקץ."},
  {"id": "person:moshe", "type": "person", "label_he": "משה רבנו", "label_en": "Moses", "aliases": ["משה"], "layer": "torah", "cluster_id": "P05", "era": "neviim", "external": {"wikidata": "Q9077", "sefaria_topic": "moses"}, "text_he": "אדון הנביאים ומקבל התורה מסיני, שממנו נמשכת שלשלת התורה שבכתב ושבעל פה."},
  {"id": "person:aharon", "type": "person", "label_he": "אהרן הכהן", "label_en": "Aaron", "aliases": ["אהרן"], "layer": "torah", "cluster_id": "P06", "era": "neviim", "external": {"wikidata": null, "sefaria_topic": "aaron"}, "text_he": "אחי משה רבנו והכהן הגדול הראשון, עמוד הכהונה ורדיפת השלום."},
  {"id": "person:yehoshua_bin_nun", "type": "person", "label_he": "יהושע בן נון", "label_en": "Joshua", "aliases": ["יהושע"], "layer": "torah", "cluster_id": "P07", "era": "neviim", "external": {"wikidata": null, "sefaria_topic": "joshua"}, "text_he": "תלמידו המובהק של משה רבנו והחוליה הראשונה במסירת התורה שבעל פה ומנחיל הארץ."},
  {"id": "person:shmuel_hanavi", "type": "person", "label_he": "שמואל הנביא", "label_en": "Samuel the Prophet", "aliases": ["שמואל הרמתי"], "layer": "torah", "cluster_id": "P07", "era": "neviim", "external": {"wikidata": null, "sefaria_topic": "samuel-(prophet)"}, "text_he": "נביא ושופט בישראל, מייסד להקות הנביאים ומושח מלכי ישראל שאול ודוד."},
  {"id": "person:david", "type": "person", "label_he": "דוד המלך", "label_en": "King David", "aliases": ["דוד בן ישי"], "layer": "torah", "cluster_id": "P08", "era": "neviim", "external": {"wikidata": "Q41370", "sefaria_topic": "king-david"}, "text_he": "מלך ישראל ומייסד שושלת בית דוד, נעים זמירות ישראל ומחבר ספר תהילים במסורת."},
  {"id": "person:shlomo", "type": "person", "label_he": "שלמה המלך", "label_en": "King Solomon", "aliases": ["שלמה", "קהלת"], "layer": "torah", "cluster_id": "P09", "era": "neviim", "external": {"wikidata": "Q37085", "sefaria_topic": "king-solomon"}, "text_he": "בן דוד המלך, בונה בית המקדש הראשון בירושלים ומחבר משלי, שיר השירים וקהלת במסורת."},
  {"id": "person:eliyahu", "type": "person", "label_he": "אליהו הנביא", "label_en": "Elijah the Prophet", "aliases": ["אליהו התשבי"], "layer": "torah", "cluster_id": "P10", "era": "neviim", "external": {"wikidata": null, "sefaria_topic": "elijah"}, "text_he": "נביא בממלכת ישראל ורבו של אלישע, המופיע במסורת חז\"ל והקבלה כמבשר הגאולה."},
  {"id": "person:yirmiyahu", "type": "person", "label_he": "ירמיהו הנביא", "label_en": "Jeremiah", "aliases": ["ירמיהו"], "layer": "torah", "cluster_id": "P12", "era": "neviim", "external": {"wikidata": null, "sefaria_topic": "jeremiah"}, "text_he": "נביא החורבן בשלהי ימי בית ראשון ומחבר ספר ירמיהו, מלכים ואיכה לפי המסורת."},
  {"id": "person:ezra", "type": "person", "label_he": "עזרא הסופר", "label_en": "Ezra the Scribe", "aliases": ["עזרא"], "layer": "torah", "cluster_id": "P13", "era": "anshei_knesset_hagedolah", "external": {"wikidata": null, "sefaria_topic": "ezra"}, "text_he": "מנהיג שיבת ציון וראש בית הדין של אנשי כנסת הגדולה בראשית ימי הבית השני."},
  {"id": "person:shimon_hatzadik", "type": "person", "label_he": "שמעון הצדיק", "label_en": "Shimon HaTzaddik", "aliases": [], "layer": "torah", "cluster_id": "P14", "era": "anshei_knesset_hagedolah", "external": {"wikidata": "Q2664632", "sefaria_topic": "shimon-hatzaddik"}, "text_he": "כהן גדול משיירי כנסת הגדולה והחוליה המקשרת בין תקופת הנביאים לתקופת הזוגות."},
  {"id": "person:antigonos", "type": "person", "label_he": "אנטיגנוס איש סוכו", "label_en": "Antigonus of Sokho", "aliases": ["אנטיגנוס איש שוכו"], "layer": "torah", "cluster_id": "P14", "era": "zugot", "external": {"wikidata": null, "sefaria_topic": "antigonus-of-sokho"}, "text_he": "חכם משיירי בית מדרשו של שמעון הצדיק ורבותיהם של הזוג הראשון."},
  {"id": "person:shimon_ben_shetach", "type": "person", "label_he": "שמעון בן שטח", "label_en": "Shimon ben Shetach", "aliases": [], "layer": "torah", "cluster_id": "P15", "era": "zugot", "external": {"wikidata": "Q338378", "sefaria_topic": null}, "text_he": "מנהיג הפרושים וחכם מן הזוג השלישי, רבותיהם של שמעיה ואבטליון."},
  {"id": "person:shemaya", "type": "person", "label_he": "שמעיה", "label_en": "Shemaya", "aliases": [], "layer": "torah", "cluster_id": "P15", "era": "zugot", "external": {"wikidata": null, "sefaria_topic": "shemaiah"}, "text_he": "חכם תנאי מזוג החמישי של הזוגות; נשיא הסנהדרין לפי המסורה."},
  {"id": "person:avtalyon", "type": "person", "label_he": "אבטליון", "label_en": "Avtalyon", "aliases": [], "layer": "torah", "cluster_id": "P15", "era": "zugot", "external": {"wikidata": null, "sefaria_topic": "avtalyon"}, "text_he": "חכם תנאי מזוג החמישי של הזוגות; אב בית דין לפי המסורה."},
  {"id": "person:hillel", "type": "person", "label_he": "הלל הזקן", "label_en": "Hillel the Elder", "aliases": ["הלל"], "layer": "torah", "cluster_id": "P15", "era": "zugot", "external": {"wikidata": "Q319219", "sefaria_topic": "hillel"}, "text_he": "חכם תנאי בולט; מנהיג הזוג האחרון ונשיא הסנהדרין, מייסד שושלת הנשיאות ובית הלל."},
  {"id": "person:shammai", "type": "person", "label_he": "שמאי הזקן", "label_en": "Shammai the Elder", "aliases": ["שמאי"], "layer": "torah", "cluster_id": "P16", "era": "zugot", "external": {"wikidata": "Q467138", "sefaria_topic": null}, "text_he": "חכם תנאי בולט; אב בית הדין של הזוג האחרון ומייסד אסכולת בית שמאי."},
  {"id": "person:yochanan_ben_zakkai", "type": "person", "label_he": "רבן יוחנן בן זכאי", "label_en": "Rabban Yochanan ben Zakkai", "aliases": ["ריב\"ז"], "layer": "torah", "cluster_id": "P17", "era": "tannaim", "external": {"wikidata": "Q733660", "sefaria_topic": "rabban-yochanan-b-zakkai"}, "text_he": "תלמיד הלל ושמאי ומכונן המרכז הרוחני והסנהדרין ביבנה לאחר חורבן הבית השני."},
  {"id": "person:eliezer_ben_hyrcanus", "type": "person", "label_he": "רבי אליעזר בן הורקנוס", "label_en": "Rabbi Eliezer ben Hyrcanus", "aliases": ["רבי אליעזר הגדול"], "layer": "torah", "cluster_id": "P17", "era": "tannaim", "external": {"wikidata": "Q1329310", "sefaria_topic": "rabbi-eliezer-b-hyrcanus"}, "text_he": "מבכירי תלמידיו של רבן יוחנן בן זכאי, בור סיד שאינו מאבד טיפה ורבו של רבי עקיבא."},
  {"id": "person:yehoshua_ben_chananiah", "type": "person", "label_he": "רבי יהושע בן חנניה", "label_en": "Rabbi Yehoshua ben Chananiah", "aliases": ["רבי יהושע"], "layer": "torah", "cluster_id": "P17", "era": "tannaim", "external": {"wikidata": null, "sefaria_topic": "rabbi-yehoshua-b-hananyah"}, "text_he": "מבכירי תלמידי רבן יוחנן בן זכאי ובר-פלוגתתו ההלכתי של רבי אליעזר בסוגיית תנורו של עכנאי."},
  {"id": "person:rabbi_akiva", "type": "person", "label_he": "רבי עקיבא בן יוסף", "label_en": "Rabbi Akiva", "aliases": ["רבי עקיבא"], "layer": "torah", "cluster_id": "P18", "era": "tannaim", "external": {"wikidata": "Q310821", "sefaria_topic": "rabbi-akiva"}, "text_he": "עמוד התורה שבעל פה בדור השלישי לתנאים, שעל שיטתו נוסדו סתם משנה, תוספתא, ספרא וספרי."},
  {"id": "person:rabbi_yishmael", "type": "person", "label_he": "רבי ישמעאל בן אלישע", "label_en": "Rabbi Yishmael", "aliases": ["רבי ישמעאל"], "layer": "torah", "cluster_id": "P18", "era": "tannaim", "external": {"wikidata": "Q2070152", "sefaria_topic": "rabbi-yishmael-b-elisha"}, "text_he": "תנא בדור השלישי ובר-פלוגתתו השיטתי של רבי עקיבא במדרשי ההלכה ובי\"ג מידות שהתורה נדרשת בהן."},
  {"id": "person:rabbi_meir", "type": "person", "label_he": "רבי מאיר", "label_en": "Rabbi Meir", "aliases": ["רבי מאיר בעל הנס"], "layer": "torah", "cluster_id": "P19", "era": "tannaim", "external": {"wikidata": "Q1621623", "sefaria_topic": "rabbi-meir"}, "text_he": "מגדולי תלמידיו של רבי עקיבא בדור הרביעי לתנאים, שסתם משנה נשנית על פי שיטתו."},
  {"id": "person:rashbi", "type": "person", "label_he": "רבי שמעון בר יוחאי", "label_en": "Rabbi Shimon bar Yochai", "aliases": ["רשב\"י", "רבי שמעון"], "layer": "torah", "cluster_id": "P19", "era": "tannaim", "external": {"wikidata": null, "sefaria_topic": "shimon-bar-yochai"}, "text_he": "מבחירי תלמידי רבי עקיבא בדור הרביעי לתנאים, בעל סתם ספרי ועמוד תורת הסוד והזוהר במסורת."},
  {"id": "person:yehuda_hanasi", "type": "person", "label_he": "רבי יהודה הנשיא", "label_en": "Rabbi Yehuda HaNasi", "aliases": ["רבי", "רבנו הקדוש"], "layer": "torah", "cluster_id": "P20", "era": "tannaim", "external": {"wikidata": "Q380427", "sefaria_topic": null}, "text_he": "נשיא הסנהדרין וחותם המשנה בשלהי תקופת התנאים, שקבע את הקורפוס הקנוני של התורה שבעל פה."},
  {"id": "person:rav", "type": "person", "label_he": "רב (אבא אריכא)", "label_en": "Rav (Abba Arikha)", "aliases": ["רב", "אבא אריכא"], "layer": "torah", "cluster_id": "P21", "era": "amoraim", "external": {"wikidata": "Q305760", "sefaria_topic": "rav"}, "text_he": "מייסד ישיבת סורא וראש הדור הראשון לאמוראי בבל, תלמיד רבי יהודה הנשיא."},
  {"id": "person:shmuel", "type": "person", "label_he": "שמואל", "label_en": "Shmuel of Nehardea", "aliases": ["מר שמואל", "שמואל ירחינאה"], "layer": "torah", "cluster_id": "P21", "era": "amoraim", "external": {"wikidata": "Q723557", "sefaria_topic": "shmuel-(amora)"}, "text_he": "ראש ישיבת נהרדעא בדור הראשון לאמוראי בבל ובר-פלוגתתו של רב בדיני ממונות ואיסורים."},
  {"id": "person:rabbi_yochanan", "type": "person", "label_he": "רבי יוחנן בר נפחא", "label_en": "Rabbi Yochanan", "aliases": ["רבי יוחנן"], "layer": "torah", "cluster_id": "P22", "era": "amoraim", "external": {"wikidata": null, "sefaria_topic": "rabbi-yochanan-b-napacha"}, "text_he": "גדול אמוראי ארץ ישראל בדור השני וראש ישיבת טבריה, שעמד ביסוד עריכת התלמוד הירושלמי."},
  {"id": "person:resh_lakish", "type": "person", "label_he": "רבי שמעון בן לקיש", "label_en": "Resh Lakish", "aliases": ["ריש לקיש"], "layer": "torah", "cluster_id": "P22", "era": "amoraim", "external": {"wikidata": null, "sefaria_topic": "rabbi-shimon-b-lakish"}, "text_he": "אמורא ארץ-ישראלי בדור השני, תלמידו-חברו ובר-פלוגתתו החריף של רבי יוחנן בטבריה."},
  {"id": "person:rav_yehuda", "type": "person", "label_he": "רב יהודה בר יחזקאל", "label_en": "Rav Yehuda", "aliases": ["רב יהודה"], "layer": "torah", "cluster_id": "P23", "era": "amoraim", "external": {"wikidata": "Q359777", "sefaria_topic": "rav-yehudah-b-yechezkel"}, "text_he": "מייסד ישיבת פומבדיתא בדור השני לאמוראי בבל ותלמידם של רב ושמואל."},
  {"id": "person:rav_yosef", "type": "person", "label_he": "רב יוסף בר חייא", "label_en": "Rav Yosef", "aliases": ["רב יוסף", "סיני"], "layer": "torah", "cluster_id": "P23", "era": "amoraim", "external": {"wikidata": null, "sefaria_topic": "rav-yosef-b-chiyya"}, "text_he": "ראש ישיבת פומבדיתא בדור השלישי לאמוראי בבל, נודע בבקיאותו כ\"סיני\" ורבו של אביי ורבא."},
  {"id": "person:abaye", "type": "person", "label_he": "אביי", "label_en": "Abaye", "aliases": ["נחמני"], "layer": "torah", "cluster_id": "P23", "era": "amoraim", "external": {"wikidata": null, "sefaria_topic": "abaye"}, "text_he": "ראש ישיבת פומבדיתא בדור הרביעי לאמוראי בבל ובר-פלוגתתו של רבא בהלכות הש\"ס."},
  {"id": "person:rava", "type": "person", "label_he": "רבא", "label_en": "Rava", "aliases": ["רבא בר יוסף בר חמא"], "layer": "torah", "cluster_id": "P23", "era": "amoraim", "external": {"wikidata": null, "sefaria_topic": null}, "text_he": "ראש ישיבת מחוזא בדור הרביעי לאמוראי בבל, שהלכה כמותו מול אביי למעט יע\"ל קג\"ם."},
  {"id": "person:rav_ashi", "type": "person", "label_he": "רב אשי", "label_en": "Rav Ashi", "aliases": [], "layer": "torah", "cluster_id": "P24", "era": "amoraim", "external": {"wikidata": null, "sefaria_topic": "rav-ashi"}, "text_he": "ראש ישיבת מתא מחסיא בדור השישי לאמוראי בבל והעורך הראשי של התלמוד הבבלי."},
  {"id": "person:ravina", "type": "person", "label_he": "רבינא", "label_en": "Ravina", "aliases": [], "layer": "torah", "cluster_id": "P24", "era": "amoraim", "external": {"wikidata": null, "sefaria_topic": "ravina-(i)"}, "text_he": "עמיתו של רב אשי בעריכת התלמוד הבבלי; \"רב אשי ורבינא סוף הוראה\"."},
  {"id": "person:saadia_gaon", "type": "person", "label_he": "רב סעדיה גאון", "label_en": "Saadia Gaon", "aliases": ["רס\"ג"], "layer": "torah", "cluster_id": "P25", "era": "geonim", "external": {"wikidata": "Q328748", "sefaria_topic": "saadia-gaon"}, "text_he": "גאון סורא, פוסק, בלשן ומחבר ספר \"אמונות ודעות\" ותרגום התורה לערבית (התפסיר)."},
  {"id": "person:hai_gaon", "type": "person", "label_he": "רב האי גאון", "label_en": "Hai Gaon", "aliases": [], "layer": "torah", "cluster_id": "P26", "era": "geonim", "external": {"wikidata": null, "sefaria_topic": "hai-gaon"}, "text_he": "בנו וממשיכו של רב שרירא גאון בראשות ישיבת פומבדיתא וחותם תקופת הגאונים בבבל."},
  {"id": "person:rif", "type": "person", "label_he": "רבי יצחק אלפסי", "label_en": "Isaac Alfasi (Rif)", "aliases": ["הרי\"ף"], "layer": "torah", "cluster_id": "P27", "era": "rishonim", "external": {"wikidata": "Q523491", "sefaria_topic": null}, "text_he": "פוסק צפון-אפריקאי וספרדי מחבר \"ספר ההלכות\", אחד משלושת עמודי ההוראה של השולחן ערוך."},
  {"id": "person:rashi", "type": "person", "label_he": "רבי שלמה יצחקי", "label_en": "Rashi", "aliases": ["רש\"י", "רבינו שלמה"], "layer": "torah", "cluster_id": "P28", "era": "rishonim", "external": {"wikidata": "Q26456", "sefaria_topic": "rashi"}, "text_he": "פרשן המקרא והתלמוד הבבלי בטרואה שבצרפת, עמוד התווך של לימוד התורה בכל הדורות."},
  {"id": "person:rabbeinu_tam", "type": "person", "label_he": "רבנו תם (רבי יעקב בן מאיר)", "label_en": "Rabbeinu Tam", "aliases": ["רבנו תם"], "layer": "torah", "cluster_id": "P29", "era": "rishonim", "external": {"wikidata": "Q944289", "sefaria_topic": null}, "text_he": "נכדו של רש\"י ומראשי בעלי התוספות בצרפת, מחבר \"ספר הישר\"."},
  {"id": "person:rambam", "type": "person", "label_he": "רבי משה בן מימון", "label_en": "Maimonides (Rambam)", "aliases": ["הרמב\"ם", "הנשר הגדול"], "layer": "torah", "cluster_id": "P30", "era": "rishonim", "external": {"wikidata": "Q127398", "sefaria_topic": "rambam"}, "text_he": "גדול הפוסקים וההוגים בימי הביניים, מחבר \"משנה תורה\" (היד החזקה), פירוש המשנה ו\"מורה נבוכים\"."},
  {"id": "person:raavad", "type": "person", "label_he": "רבי אברהם בן דוד מפושקיירש", "label_en": "Raavad of Posquieres", "aliases": ["הראב\"ד"], "layer": "torah", "cluster_id": "P30", "era": "rishonim", "external": {"wikidata": null, "sefaria_topic": "raavad"}, "text_he": "מגדולי חכמי פרובנס ובעל ההשגות על ספר \"משנה תורה\" להרמב\"ם."},
  {"id": "person:ramban", "type": "person", "label_he": "רבי משה בן נחמן", "label_en": "Nahmanides (Ramban)", "aliases": ["הרמב\"ן"], "layer": "torah", "cluster_id": "P31", "era": "rishonim", "external": {"wikidata": "Q355455", "sefaria_topic": "ramban"}, "text_he": "מגדולי חכמי ספרד בפרשנות המקרא, חידושי הש\"ס והקבלה, מכונן היישוב היהודי בירושלים ובארץ ישראל."},
  {"id": "person:rosh", "type": "person", "label_he": "רבי אשר בן יחיאל", "label_en": "Asher ben Jehiel (Rosh)", "aliases": ["הרא\"ש"], "layer": "torah", "cluster_id": "P32", "era": "rishonim", "external": {"wikidata": "Q722525", "sefaria_topic": null}, "text_he": "מגדולי הפוסקים באשכנז ובספרד, תלמיד מהר\"ם מרוטנבורג ואחד משלושת עמודי ההוראה."},
  {"id": "person:tur", "type": "person", "label_he": "רבי יעקב בן אשר", "label_en": "Jacob ben Asher (Tur)", "aliases": ["בעל הטורים", "הטור"], "layer": "torah", "cluster_id": "P32", "era": "rishonim", "external": {"wikidata": "Q1376849", "sefaria_topic": null}, "text_he": "בנו ותלמידו של הרא\"ש ומחבר \"ארבעה טורים\", שעל מתכונתו נבנו הבית יוסף והשולחן ערוך."},
  {"id": "person:yosef_karo", "type": "person", "label_he": "רבי יוסף קארו", "label_en": "Yosef Karo", "aliases": ["מרן", "הבית יוסף"], "layer": "torah", "cluster_id": "P33", "era": "acharonim", "external": {"wikidata": "Q467148", "sefaria_topic": "joseph-karo"}, "text_he": "מחבר \"בית יוסף\", \"כסף משנה\" ו\"שולחן ערוך\" בצפת, הפוסק המרכזי של עולם ההלכה."},
  {"id": "person:rema", "type": "person", "label_he": "רבי משה איסרליש", "label_en": "Moses Isserles (Rema)", "aliases": ["הרמ\"א"], "layer": "torah", "cluster_id": "P33", "era": "acharonim", "external": {"wikidata": null, "sefaria_topic": "moses-isserles-(rema)"}, "text_he": "פוסק יהדות אשכנז בקרקוב, מחבר \"דרכי משה\" והגהות \"המפה\" על השולחן ערוך."},
  {"id": "person:ari", "type": "person", "label_he": "רבי יצחק לוריא אשכנזי", "label_en": "Isaac Luria (Ari)", "aliases": ["האר\"י הקדוש", "האר\"י"], "layer": "kabbalah", "cluster_id": "P34", "era": "acharonim", "external": {"wikidata": "Q339509", "sefaria_topic": "isaac-luria"}, "text_he": "מייסד הקבלה הלוריאנית בצפת במאה ה-16, שתורתו נערכה בכתבי תלמידו רבי חיים ויטאל."},
  {"id": "person:vilna_gaon", "type": "person", "label_he": "רבי אליהו מווילנה", "label_en": "Vilna Gaon (Gra)", "aliases": ["הגר\"א", "הגאון מווילנה"], "layer": "torah", "cluster_id": "P37", "era": "acharonim", "external": {"wikidata": "Q279359", "sefaria_topic": "vilna-gaon"}, "text_he": "מגדולי האחרונים בליטא בנגלה ובנסתר, בעל ביאור הגר\"א על השולחן ערוך והגהות הש\"ס."},
  {"id": "person:chaim_of_volozhin", "type": "person", "label_he": "רבי חיים מוולוז'ין", "label_en": "Chaim of Volozhin", "aliases": ["רבי חיים מוולוזין"], "layer": "torah", "cluster_id": "P37", "era": "acharonim", "external": {"wikidata": "Q1059243", "sefaria_topic": "chaim-of-volozhin"}, "text_he": "תלמידו המובהק של הגר\"א, מייסד ישיבת וולוז'ין אם הישיבות ומחבר \"נפש החיים\"."},
  {"id": "person:shneur_zalman", "type": "person", "label_he": "רבי שניאור זלמן מלאדי", "label_en": "Shneur Zalman of Liadi", "aliases": ["אדמו\"ר הזקן", "בעל התניא"], "layer": "torah", "cluster_id": "P36", "era": "acharonim", "external": {"wikidata": "Q547033", "sefaria_topic": "shneur-zalman-of-liadi"}, "text_he": "מייסד חסידות חב\"ד ומחבר ספר \"התניא\" ו\"שולחן ערוך הרב\"."},
  {"id": "person:chaim_soloveitchik", "type": "person", "label_he": "רבי חיים הלוי סולובייצ'יק", "label_en": "Chaim Soloveitchik", "aliases": ["רבי חיים מבריסק"], "layer": "torah", "cluster_id": "P39", "era": "acharonim", "external": {"wikidata": "Q2637350", "sefaria_topic": null}, "text_he": "מייסד שיטת בריסק בלימוד התלמוד ומחבר חידושי רבנו חיים הלוי על הרמב\"ם."},
  {"id": "person:or_sameach", "type": "person", "label_he": "רבי מאיר שמחה הכהן מדווינסק", "label_en": "Meir Simcha of Dvinsk", "aliases": ["האור שמח", "משך חכמה"], "layer": "torah", "cluster_id": "P39", "era": "acharonim", "external": {"wikidata": null, "sefaria_topic": null}, "text_he": "רבה של עדת המתנגדים בדווינסק לצד הגאון הרוגצ'ובר, מחבר \"אור שמח\" על הרמב\"ם ו\"משך חכמה\"."},
  {"id": "person:rogatchover", "type": "person", "label_he": "רבי יוסף רוזין (הרוגצ'ובר)", "label_en": "Yosef Rozin (Rogatchover Gaon)", "aliases": ["הגאון הרוגצ'ובר", "צפנת פענח"], "layer": "torah", "cluster_id": "P40", "era": "acharonim", "external": {"wikidata": null, "sefaria_topic": null}, "text_he": "רבה החסידי של דווינסק ומחבר סדרת \"צפנת פענח\" על התורה, הש\"ס ומשנה תורה להרמב\"ם."},
  {"id": "person:ovadia_yosef", "type": "person", "label_he": "הרב עובדיה יוסף", "label_en": "Ovadia Yosef", "aliases": ["מרן הרב עובדיה", "יביע אומר"], "layer": "torah", "cluster_id": "P40", "era": "acharonim", "external": {"wikidata": "Q467172", "sefaria_topic": null}, "text_he": "הראשון לציון והרב הראשי לישראל, מחבר שו\"ת \"יביע אומר\" ו\"חזון עובדיה\"."}
